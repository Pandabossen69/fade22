# Sätts i Vercel → Project → Settings → Environment Variables (Production, och Preview om förhandsversionen ska kunna boka).
ADMIN_PASSWORD=        # lösenordet till /admin, minst 6 tecken. Inget standardlösenord finns.
SESSION_SECRET=        # valfri lång slumpsträng (signerar inloggningen). Byt den = alla loggas ut.
BLOB_READ_WRITE_TOKEN= # sätts automatiskt när en Vercel Blob-store kopplas till projektet
NOTIFY_NTFY_TOPIC=     # t.ex. adaycutz-k3j9x2 (svårgissat). Barberaren prenumererar i appen ntfy → notis vid varje bokning
